# ============================================================
# Variáveis de ambiente — copie este arquivo para ".env"
# Nunca suba o arquivo ".env" real com segredos para o repositório.
# ============================================================

# Chave secreta usada para sessões e tokens CSRF.
# Em produção, use um valor longo e aleatório, ex:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me

# Porta local de execução
PORT=5000

# Modo de execução (true em desenvolvimento / false em produção)
DEBUG=true