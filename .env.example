# ============================================================
# Variáveis de ambiente — copie este arquivo para ".env"
# Nunca suba o arquivo ".env" real com segredos para o repositório.
# ============================================================

# Porta local de execução (usada em desenvolvimento)
PORT=5000

# Modo de execução (true em desenvolvimento / false em produção)
DEBUG=true

# ============================================================
# Notificações push (Web Push / VAPID)
# Gere o par de chaves com:  npx web-push generate-vapid-keys --json
# ============================================================
VAPID_PUBLIC_KEY=cole-a-chave-publica-aqui
VAPID_PRIVATE_KEY=cole-a-chave-privada-aqui
VAPID_SUBJECT=mailto:contato@igrejacaminhar.com.br

# Minutos de antecedência do lembrete antes do início do culto/evento
NOTIFY_MINUTES_BEFORE=60